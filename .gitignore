# competition rulebook (not ours to publish)
*.pdf
# FreeCAD backups
*.FCBak
# video build intermediates (regenerate with design/video/*.py); the published video is docs/media/wing_build.mp4
design/video/frames/
design/video/clips/
design/video/audio/
design/video/wing_build.mp4
design/video/wing_build.en.vtt
# local tooling
.claude/
__pycache__/
*.pyc
.DS_Store

# the build-kit BOM is ours (generated)
!build-kit/*.pdf
!docs/bom/*.pdf

# STEP export is 110 MB (over the GitHub file limit): commit the zip (export_views.py writes both)
design/cad_fusion_revB/export/*.step
# Fusion build progress (written while a bridge job runs)
design/cad_fusion_revB/check/build_progress.txt
# SOLIDWORKS Simulation solver files and parts (rebuilt by run_fea.ps1 from the case JSON)
design/simulation/structure/cases/*.SLDPRT
design/simulation/structure/cases/*-*.*
!design/simulation/structure/cases/*.png
!design/simulation/structure/cases/*.json
design/simulation/structure/cases/*.dat
# SOLIDWORKS scratch anywhere under design/simulation (lock files, logs, solver files, P4 benchmark)
design/simulation/**/~$*
design/simulation/**/PerformanceLog.txt
design/simulation/**/*.CWR
design/simulation/**/*.gsz
design/simulation/**/*-BenchMark-Solver.txt
design/simulation/p4/*.SLDPRT
# CFD geometry parts (rebuilt by design/simulation/aero/run_cfd_geom.ps1)
design/simulation/aero/cfd/*.SLDPRT
# AVL run output is summarised in design/simulation/aero/results.json
